# ============================================================
# QuantX 环境变量配置
# 复制本文件到 .env 并修改对应值
# ============================================================

# 应用基础配置
HOST=0.0.0.0
PORT=5000
DEBUG=false
APP_NAME=QuantX API
LOG_LEVEL=INFO

# 安全密钥（生产环境必须修改！）
SECRET_KEY=quantx-secret-key-change-me

# 管理员账号（首次启动自动创建）
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# PostgreSQL 数据库
DATABASE_URL=postgresql://quantx:quantx123@localhost:5432/quantx
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_POOL_ACQUIRE_TIMEOUT=10

# Redis 缓存
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
ENABLE_CACHE=false

# K线缓存 TTL（秒）
KLINE_TTL_1M=120
KLINE_TTL_5M=300
KLINE_TTL_1H=1800
KLINE_TTL_1D=86400

# 数据源 API Key（按需配置）
TUSHARE_TOKEN=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# 前端 CORS 来源
FRONTEND_URL=http://localhost:8888,http://localhost:8000

# Gunicorn 并发配置
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_LOG_LEVEL=info

# 时区（IANA 格式）
TZ=Asia/Shanghai
